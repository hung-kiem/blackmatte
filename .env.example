# Environment Variables — Local Development
# Copy file này thành .env và điền giá trị thật vào các biến có dấu <...>
# ⚠️ KHÔNG COMMIT file .env — chỉ commit file .env.example này

# =============================================================================
# DATABASE (PostgreSQL 16 — Docker Local)
# docker-compose up -d sẽ tự tạo database với các user này
# =============================================================================

# superadmin — Dùng cho Prisma Migrate / Schema DDL (toàn quyền)
DATABASE_URL="postgresql://superadmin:superadmin_password@localhost:5432/blackmatte_db"

# admin_user — Dùng cho apps/admin (CRUD: INSERT, UPDATE, DELETE, SELECT)
DATABASE_URL_ADMIN="postgresql://admin_user:admin_password_local@localhost:5432/blackmatte_db"

# web_user — Dùng cho apps/web (SELECT only — read-only)
DATABASE_URL_WEB="postgresql://web_user:web_password_local@localhost:5432/blackmatte_db"

# =============================================================================
# NEXTAUTH — Authentication (apps/admin)
# =============================================================================

# Secret key để mã hóa JWT — thay bằng chuỗi random dài 32+ ký tự
NEXTAUTH_SECRET="change-this-to-a-random-32-char-secret-key"

# URL của Admin Portal khi chạy local
NEXTAUTH_URL="http://localhost:3001"

# =============================================================================
# AWS S3 — Media Storage (Ảnh, PDF, Video)
# Điền sau khi đã setup AWS S3 bucket
# =============================================================================

AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID="<your-aws-access-key-id>"
AWS_SECRET_ACCESS_KEY="<your-aws-secret-access-key>"
AWS_S3_BUCKET_NAME="<your-s3-bucket-name>"
# URL public của S3 bucket (hoặc CloudFront distribution URL)
AWS_S3_PUBLIC_URL="https://<bucket-name>.s3.<region>.amazonaws.com"

# =============================================================================
# APP URLs
# =============================================================================

NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"

ADMIN_EMAIL="admin@blackmatte.dev"
ADMIN_PASSWORD="your-strong-password"